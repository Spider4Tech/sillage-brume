#!/usr/bin/env bash
# Lance une longue campagne SILLAGE en arrière-plan ; guide : docs/CAMPAGNE_24H.md
#
#   ./runlong [heures]     lance (défaut : 24 h) ; si une campagne est restée inachevée, la reprend
#   ./runlong --neuf [h]   repart de zéro (la campagne précédente est archivée)
#   ./runlong --statut     où on en est
#   ./runlong --arreter    arrêt propre, reprise possible avec ./runlong
#
# Le calcul survit à la fermeture du terminal, pas à un arrêt de la machine : après une coupure, relancer ./runlong.
set -u
cd "$(dirname "$(readlink -f "$0")")"
LOG=resultats/nuit/journal.log
PID=resultats/nuit/run.pid

en_cours() { [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && grep -q rundenuit "/proc/$(cat "$PID")/cmdline" 2>/dev/null; }
descendants() { local p; for p in $(pgrep -P "$1" 2>/dev/null); do echo "$p"; descendants "$p"; done; }

statut() {
    if en_cours; then echo "État : en cours"
    elif [ -f "$LOG" ] && grep -q '\] terminé$' "$LOG"; then echo "État : terminée"
    elif [ -f "$LOG" ]; then echo "État : arrêtée avant la fin ; ./runlong pour reprendre"
    else echo "État : aucune campagne"; return; fi
    [ -f "$LOG" ] || return
    prevu=$(sed -n 's/.*campagne de nuit : [0-9.]* h (\([0-9]*\) s).*/\1/p' "$LOG" | head -1)
    debut=$(date -d "$(sed -n '1s/^\[\([^]]*\)\].*/\1/p' "$LOG")" +%s)
    ecoule=$(( $(date +%s) - debut ))
    [ -n "$prevu" ] && [ "$prevu" -gt 0 ] && echo "Temps : $((ecoule / 3600)) h $((ecoule % 3600 / 60)) min écoulées sur $((prevu / 3600)) h ($((100 * ecoule / prevu)) %), arrêts compris"
    echo "Campagne : $(grep -E '\] [0-9a-z]+/6 ' "$LOG" | tail -1 | cut -d' ' -f3-)"
    echo "Échecs jusqu'ici : $(cat resultats/nuit_*.md 2>/dev/null | grep -c '\*\*ÉCHEC\*\*')"
    if [ -s resultats/nuit/sante.csv ]; then
        tail -1 resultats/nuit/sante.csv | awk -F, '{ printf "Dernier relevé (%s) : %s °C, %s MHz, charge %s, %d Gio libres\n", $1, $2, $3, $4, $5 / 1024 }'
        awk -F, 'NR > 1 && $2 + 0 > m { m = $2 + 0 } END { if (m) printf "Température maximale : %d °C\n", m }' resultats/nuit/sante.csv
    fi
    grep -E 'ARRÊT DE SÉCURITÉ|DÉLAI DÉPASSÉ|attention :' "$LOG" | tail -3
    f=$(ls -t resultats/campagne_*.tar.gz 2>/dev/null | head -1)
    [ -n "$f" ] && echo "Dernier paquet à transmettre : $f"
}

case "${1:-}" in
    --statut) statut; exit 0 ;;
    --arreter)
        en_cours || { echo "aucune campagne en cours"; exit 0; }
        p=$(cat "$PID")
        kill -TERM "$p"                                  # noté d'abord : bash le traite dès que l'enfant meurt
        for d in $(descendants "$p"); do kill -TERM "$d" 2>/dev/null; done
        echo "arrêt demandé ; reprise : ./runlong"
        exit 0 ;;
    --neuf) NEUF=1; shift ;;
    -*) sed -n '2,8p' "$0" | cut -c3-; exit 1 ;;
    *) NEUF=0 ;;
esac

en_cours && { echo "une campagne tourne déjà :"; statut; exit 1; }

H="${1:-24}"
awk -v h="$H" 'BEGIN { exit !(h > 0) }' || { echo "durée invalide : $H" >&2; exit 1; }
[ -x .venv/bin/python3 ] || ./preparer_campagne.sh >/dev/null 2>&1 || ./preparer_campagne.sh --installer >/dev/null 2>&1
./preparer_campagne.sh || exit 1

mkdir -p resultats/nuit
if [ "$NEUF" = 0 ] && [ -f "$LOG" ] && ! grep -q '\] terminé$' "$LOG" && grep -q 'campagne de nuit :' "$LOG"; then
    echo "Campagne inachevée trouvée : reprise, avec le temps qu'il lui restait."
    SILLAGE_REPRISE=1 setsid nohup ./rundenuit.sh </dev/null >>resultats/nuit/console.log 2>&1 &
else
    setsid nohup ./rundenuit.sh "$H" </dev/null >resultats/nuit/console.log 2>&1 &
fi
sleep 3
kill -0 $! 2>/dev/null || { tail -20 resultats/nuit/console.log; echo "échec du lancement" >&2; exit 1; }
echo
echo "Lancé en arrière-plan : vous pouvez fermer ce terminal."
echo "  ./runlong --statut    où on en est"
echo "  ./runlong --arreter   arrêt propre"
